{
  "enabledPlugins": {
    "rust-skills@rust-skills": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty'); [ -n \"$f\" ] && [ \"${f##*.}\" = \"rs\" ] && rustfmt \"$f\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
